from django_auth_ldap.config import LDAPSearch, LDAPGroupQuery, MemberDNGroupType
import ldap

AUTH_LDAP_SERVER_URI = "<%= $ldap_server_uri %>"
AUTH_LDAP_BIND_DN = ""
AUTH_LDAP_BIND_PASSWORD = ""
AUTH_LDAP_USER_SEARCH = LDAPSearch("ou=people,ou=rgy,o=desy,c=de", ldap.SCOPE_SUBTREE, "(uid=%(user)s)")
AUTH_LDAP_GROUP_SEARCH = LDAPSearch("ou=group,ou=rgy,o=desy,c=de", ldap.SCOPE_SUBTREE, "(objectClass=groupOfUniqueNames)")
AUTH_LDAP_GROUP_TYPE = MemberDNGroupType("uniqueMember")
AUTH_LDAP_REQUIRE_GROUP = LDAPGroupQuery("cn=belle2,ou=group,ou=rgy,o=desy,c=de")
AUTH_LDAP_USER_ATTR_MAP = {"first_name": "givenName", "last_name": "sn", "email": "mail"}

AUTHENTICATION_BACKENDS += [
    "django_auth_ldap.backend.LDAPBackend",
]

